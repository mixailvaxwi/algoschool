# Пример переменных окружения для AlgoSchool.
#
# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
#
# Spring Boot не читает .env сам. Способы передать переменные:
#   - IntelliJ IDEA: Run Configuration -> Environment variables
#   - терминал:      set -a && . ./.env && set +a && ./mvnw spring-boot:run
#   - docker compose: env_file: .env
#
# ВАЖНО: .env не коммитить. Коммитится только этот файл-образец.

# --- База данных ---------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/algoschool?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
# Обязательно. Приложение не стартует, если не задано.
DB_PASSWORD=

# --- JWT -----------------------------------------------------------------
# Обязательно. Base64, минимум 32 байта (256 бит) — требование HS256.
# Сгенерировать новый секрет:
#   openssl rand -base64 32
# НЕ переиспользуйте ключ из истории git — он публичный, его нужно считать
# скомпрометированным. Смена ключа разлогинит всех: старые токены станут невалидными.
JWT_SECRET=

# --- Ejudge --------------------------------------------------------------
# Можно оставить пустым: без ключа проверка кода не работает, но приложение поднимется.
EJUDGE_BASE_URL=http://localhost
EJUDGE_API_KEY=
EJUDGE_BOT_LOGIN=ejudge

# Опрос вердиктов у Ejudge. Поставьте false, если Ejudge не запущен локально.
EJUDGE_POLLING_ENABLED=true
